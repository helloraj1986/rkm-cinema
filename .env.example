# RKM Watchlist — environment variables (DO NOT commit real values)
# Copy to a real .env (kept OUT of git) and fill in your values.
# Secrets are read ONLY server-side inside the FastAPI container; the browser
# never sees them.

# --- Media host (LAN IP of the machine running Plex/*arr) ---
MEDIA_HOST=192.168.65.254

# --- Download automation (primary) ---
RADARR_URL=http://192.168.65.254:7878
RADARR_API_KEY=
SONARR_URL=http://192.168.65.254:8989
SONARR_API_KEY=

# Optional *arr quality-profile overrides (IDs in Radarr/Sonarr)
RADARR_QUALITY_PROFILE_ID=
SONARR_QUALITY_PROFILE_ID=

# --- Metadata / artwork ---
TMDB_API_KEY=
# TVDB_API_KEY=              # optional; Superseded by YouTube-scrape trailers

# --- Media servers (Plex is the source of truth; Emby shares the library) ---
PLEX_URL=http://192.168.65.254:32400
PLEX_TOKEN=
# How long Plex's full-library scan stays cached (seconds). Default 3600 (1h) —
# the refresh button / reconcile reuse one scan instead of re-scanning Plex on
# every click. Lower for faster pickup of new library items.
# PLEX_SCAN_TTL=3600
# Emby (HTTPS-only over Tailscale at :8096; shares the same library as Plex)
EMBY_URL=http://192.168.65.254:8096
EMBY_API_KEY=

# --- Optional / legacy ---
# JELLYFIN_URL=http://192.168.65.254:8096
# JELLYFIN_API_KEY=
# PROWLARR_URL=http://192.168.65.254:9696
# PROWLARR_API_KEY=
# YOUTUBE_API_KEY=           # not required — trailers are scraped from youtube.com

# --- qBittorrent (download progress; no auth on this setup) ---
QBITTORRENT_URL=http://192.168.65.254:1701

# --- Public (tailnet) URLs used for deep links ---
# BROWSER_RADARR_URL=http://rkm-hp.tail8d5e8.ts.net:8989
# BROWSER_SONARR_URL=http://rkm-hp.tail8d5e8.ts.net:8989
