# ============================================================================
# RKM Cinema — ONE env file for the whole stack
# ============================================================================
# Copy this file to `.env` (in THIS repo folder) and fill in your values.
# `.env` is git-ignored — never commit real keys.
#
#   Windows:  copy .env.example .env     then edit .env
#   Then:     .\bootstrap.ps1            (renders .rkm.env + starts the stack)
#
# bootstrap.ps1 + render_config.py + docker compose read EVERYTHING from this
# one file. There is no rkm.config.toml any more.
# ============================================================================

# ------------------------------ compose / runtime --------------------------
# Host folder for the stack's data. One dir mounted at /data in every service
# (media/_movie, media/_tv = Jellyfin libraries, downloads = qBittorrent,
# rkm/ = app watchlist DB). Relative paths are resolved against this repo.
RKM_MEDIA_PATH=./data
# Host ports. Prod RKM uses 8123/8096 — this isolated experiment defaults to
# 8124/8098 so it can't collide.
RKM_DASHBOARD_PORT=8124
RKM_JELLYFIN_PORT=8098
RKM_TIMEZONE=Australia/Melbourne
RKM_PUID=1000
RKM_PGID=1000

# ------------------------------ media backend ------------------------------
# Which library provider the API uses: jellyfin (bundled container) |
# plex | emby. Jellyfin is auto-provisioned by bootstrap; Plex/Emby point at
# servers you already run (URLs below).
MEDIA_SERVER=jellyfin

# Jellyfin — the bundled stack runs its own Jellyfin container; bootstrap
# auto-creates this admin. Leave the password blank on first run and
# render_config will generate one and SAVE it back into this .env.
RKM_JELLYFIN_ADMIN_USER=admin
RKM_JELLYFIN_ADMIN_PASSWORD=
# URL for browser deep-links ("Open in Jellyfin"): use the host/tailnet address.
RKM_JELLYFIN_BROWSER=http://localhost:8098
# Optional: override the container-to-container Jellyfin address (default is
# the bundled container http://jellyfin:8096). Set only for an EXTERNAL Jellyfin.
# JELLYFIN_URL=http://192.168.65.254:8096

# Plex / Emby — fill when MEDIA_SERVER=plex|emby (or to use them as watch
# sources alongside the backend). PLEX_TOKEN is server-side only.
PLEX_URL=http://192.168.65.254:32400
PLEX_TOKEN=
EMBY_URL=http://192.168.65.254:8096
EMBY_API_KEY=

# ------------------------------ metadata -----------------------------------
# TMDB key is REQUIRED (Suggest/search/discovery).
TMDB_API_KEY=
# TVDB_API_KEY=              # optional

# ------------------------------ download automation ------------------------
# Radarr/Sonarr you already run — paste URL + API key (found under
# Radarr/Sonarr -> Settings -> General -> API Key).
RADARR_URL=http://192.168.65.254:7878
RADARR_API_KEY=
SONARR_URL=http://192.168.65.254:8989
SONARR_API_KEY=
# Optional: *arr quality-profile IDs used for requests (blank = *arr default).
RADARR_QUALITY_PROFILE_ID=
SONARR_QUALITY_PROFILE_ID=
# Prowlarr / qBittorrent (optional; qbit drives download progress).
PROWLARR_URL=http://192.168.65.254:9696
PROWLARR_API_KEY=
QBITTORRENT_URL=http://192.168.65.254:1701
# Public/tailnet URLs for UI deep links (optional).
# BROWSER_RADARR_URL=http://rkm-hp.tail8d5e8.ts.net:8989
# BROWSER_SONARR_URL=http://rkm-hp.tail8d5e8.ts.net:8989

# ------------------------------ app store & jobs ---------------------------
# Watchlist store: 'json' (default) | 'sqlite'. Path is INSIDE the api
# container on the media volume (/data = RKM_MEDIA_PATH) so it survives rebuilds.
WATCHLIST_STORE=json
WATCHLIST_DB_PATH=/data/rkm/watchlist.json
# Background jobs inside the api container.
WATCHLIST_SCHEDULER=true
AUTO_ADD_ENABLED=false
AUTO_ADD_HOUR=18
RECONCILE_INTERVAL_MIN=10
