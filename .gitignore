# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets & env — NEVER commit API keys/tokens
.env
.env.*
!.env.example
*.env
!*.env.example

# Test / build caches
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# Runtime data / state — watchlist data + dashboard output live outside the repo
watchlist.json
dashboard-data.json
index.html
!index.html
dashboard.html
*.log
*.tmp
nohup.out

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Container
docker-compose.override.yml

# CI workflow — authored but NOT pushed yet (token lacks 'workflow' scope).
# Kept on disk for later bring-up; un-ignore + commit when ready.
.github/workflows/ci.yml

# Repo-level .env is the SINGLE config (git-ignored; .env.example committed).
# ./data is runtime media for the bundled stack.
rkm.config.toml
.rkm.env
.rkm_state.json
data/
provisioner/__pycache__/

# Working backups / scratch
*.backup
*.backup2
*.backup3
*.bak
*.orig
*.before*
*.before_sed
*.tmp
cinemagoer.db
app.js.bak3

# Player layout harness fixture (downloaded by frontend/harness/README.md, not source)
frontend/public/harness-sample.mp4

# ---- Apple clients (apple/) ----
# Xcode per-user state must never be committed; everything else in the projects IS source.
**/xcuserdata/
**/*.xcuserstate
**/*.xcscmblueprint
**/DerivedData/
**/.build/
**/.swiftpm/configuration/
**/*.moved-aside
**/Pods/

# The Xcode projects are GENERATED from project.yml by XcodeGen — build output, not source.
# The fix for a project setting is in project.yml + one regenerate, never in Xcode's UI
# (a GUI change would be lost on the next generate). See apple/WORKFLOW.md §2.
apple/**/*.xcodeproj/
apple/**/*.xcworkspace/

# Test-run logs. They travel back by PASTING (apple/LOGGING.md §7); if a whole file ever
# needs to reach the repo, un-ignore that one file explicitly: git add -f apple/logs/<file>
apple/logs/

# Generated API types ARE committed on purpose (see apple/scripts/generate-api.sh) —
# do not ignore apple/**/Core/GeneratedAPI/.
